# Apache .htaccess file for Angular SPA routing
# Enable rewrite engine
RewriteEngine On

# Serve static HTML files directly
RewriteCond %{REQUEST_URI} \.html$
RewriteRule ^ - [L]

# Handle Angular app routes (redirect to app.html for Angular routes)
# Only rewrite if the file/directory doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Rewrite Angular app routes to app.html
RewriteRule ^(login|signup|dashboard|profile|mobile|desktop|app|ai-tools|resume|admin|invite|demo|implementation|gains-calculator|founders|news|maintenance|webhook)(/.*)?$ app.html [L]