# Apache .htaccess file for Angular SPA routing
# Enable rewrite engine
RewriteEngine On

# Serve start.html for the root path only
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ start.html [L]

# Handle Angular routes
# If the request is for a file or directory that exists, serve it
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise, serve index.html for all routes
RewriteRule ^.*$ index.html [L]