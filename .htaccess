# Apache .htaccess file for Angular SPA routing
# Enable rewrite engine
RewriteEngine On

# Handle Angular routes
# If the request is for a file or directory that exists, serve it
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Don't rewrite requests for .html files (let them be served as static files)
RewriteCond %{REQUEST_URI} !\.html$

# Otherwise, serve index.html for all routes
RewriteRule ^.*$ index.html [L]