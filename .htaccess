# Apache .htaccess file for Angular SPA routing
# Enable rewrite engine
RewriteEngine On

# Serve static HTML files directly (except app.html which is the Angular app)
RewriteCond %{REQUEST_URI} \.html$
RewriteCond %{REQUEST_URI} !^/app\.html$
RewriteRule ^ - [L]

# Handle Angular app routes
# Only rewrite if the file/directory doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Rewrite all other routes to app.html (the Angular app)
RewriteRule ^.*$ app.html [L]